; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Adepts of Establishment"
config/version="v0.2.0"
run/main_scene="uid://rhljgisluynr"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://Autoload/EventBus.gd"
GlobalDefs="*res://Autoload/GlobalDefs.gd"
DataBuffer="*res://Autoload/DataBuffer.gd"
GameSettings="*res://Autoload/GameSettings.gd"

[debug]

gdscript/warnings/unused_variable=0
gdscript/warnings/unused_local_constant=0
gdscript/warnings/unused_private_class_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0
gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/resizable=false
window/snap/snap_2d_transforms_to_pixel=false

[editor]

movie_writer/movie_file="/home/vikasu/godot/projects/adepts-of-establishment/recorded footage/video1.avi"
version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/Todo_Manager/plugin.cfg", "res://addons/strategy_cam/plugin.cfg")

[gui]

timers/tooltip_delay_sec=0.1

[importer_defaults]

wav={
&"edit/normalize": true
}

